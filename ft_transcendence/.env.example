# Copy to .env and fill in real values:  cp .env.example .env
VAULT_ROOT_TOKEN=change_me

# JWT signing keys (generate with: openssl rand -base64 32)
SECRET_KEY=change_me
REFRESH_SECRET_KEY=change_me

# Mail (Mailtrap token + Gmail app password)
SMTP_ACCESS_TOKEN=change_me
SMTP_CLIENT=your_email@gmail.com
SMTP_PASSWORD=change_me

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
